{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phoenix Desktop",
  "version": "0.1.0",
  "identifier": "cloud.kitt.phoenix",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/angular-notes/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phoenix Desktop",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
